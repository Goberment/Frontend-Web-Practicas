{
  "name": "practica4-api-rest",
  "version": "1.0.0",
  "type": "module",
  "description": "Practica 4 - La capa de dominio expuesta como API REST con Express",
  "scripts": {
    "dev": "tsx src/main.ts",
    "servidor": "npm run build:cliente && tsx http/servidor.ts",
    "build:cliente": "tsc -p tsconfig.cliente.json && node scripts/copiar-cliente.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "build": "tsc",
    "start": "node dist/src/main.js"
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "tsx": "^4.0.0",
    "typescript": "^6.0.0"
  }
}
