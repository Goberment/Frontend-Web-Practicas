{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "outDir": "dist-cliente",
    "rootDir": ".",

    "strict": true,
    "noUncheckedIndexedAccess": true,

    "sourceMap": true,
    "skipLibCheck": true
  },
  "include": ["publico/**/*.ts", "contratos/**/*.ts"]
}
